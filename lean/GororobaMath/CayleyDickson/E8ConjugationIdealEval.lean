module

public import GororobaMath.CayleyDickson.E8ConjugationIdeal

/-!
# The conjugation identity of the germ ideals at a point

Convention: as in `GororobaMath.CayleyDickson.E8ConjugationIdeal`, `jmAt v` and `jpAt v` are the 27
generators of J_N- and J_N+ evaluated at the vector `v` of the ten variables (`v 0` is `i`, `v n`
is `s_n`), and `phiVars v` is that vector after the conjugation Phi.

## Main results

* `CayleyDickson.E8Conjugation.span_phi_jm_eval`: in every commutative ring `A` and at every point
  `v`, the ideal generated by the generators of J_N- at `phiVars v` equals the ideal generated by
  the generators of J_N+ at `v`; it is `span_phi_jm` evaluated at `v`.
* `CayleyDickson.E8Conjugation.mem_span_phi_jm_eval`: the same equality as a membership statement,
  the form that `conjugation_ideal_bridge` of `rocq/quantum/E8ConjugationIdealBridge.v` states at
  `A := ℤ`.
-/

@[expose] public section

namespace CayleyDickson.E8Conjugation

variable {A : Type*} [CommRing A]

/-- Generator `k` of J_N- at the point after Phi is `phiSign k` times generator `k` of J_N+. -/
theorem jmAt_phiVars (v : Fin 10 → A) (k : Fin 27) :
    jmAt (phiVars v) k = (phiSign k : A) * jpAt v k :=
  jm_phi (v 0) (v 1) (v 2) (v 3) (v 4) (v 5) (v 6) (v 7) (v 8) (v 9) k

/-- At every point, the generators of J_N- after Phi and those of J_N+ generate the same ideal. -/
theorem span_phi_jm_eval (v : Fin 10 → A) :
    Ideal.span (Set.range (jmAt (phiVars v))) = Ideal.span (Set.range (jpAt v)) := by
  apply le_antisymm
  · rw [Ideal.span_le]
    rintro _ ⟨k, rfl⟩
    rw [jmAt_phiVars]
    exact Ideal.mul_mem_left _ _ (Ideal.subset_span ⟨k, rfl⟩)
  · rw [Ideal.span_le]
    rintro _ ⟨k, rfl⟩
    have h : jpAt v k = (phiSign k : A) * jmAt (phiVars v) k := by
      rw [jmAt_phiVars, ← mul_assoc, phiSign_mul_self, one_mul]
    rw [h]
    exact Ideal.mul_mem_left _ _ (Ideal.subset_span ⟨k, rfl⟩)

/-- Membership form of `span_phi_jm_eval`. -/
theorem mem_span_phi_jm_eval (v : Fin 10 → A) (x : A) :
    x ∈ Ideal.span (Set.range (jmAt (phiVars v))) ↔ x ∈ Ideal.span (Set.range (jpAt v)) := by
  rw [span_phi_jm_eval]

end CayleyDickson.E8Conjugation
