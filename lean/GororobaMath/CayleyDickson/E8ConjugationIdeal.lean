module

public import Mathlib.Algebra.MvPolynomial.Basic
public import Mathlib.Algebra.MvPolynomial.Eval
public import Mathlib.Data.Fin.VecNotation
public import Mathlib.RingTheory.Ideal.Span
public import Mathlib.Tactic.FinCases
public import Mathlib.Tactic.Ring

/-!
# The conjugation maps the germ ideal of N- onto the one of N+

Convention: `jm` and `jp` list the 27 generators of the ideals J_N- and J_N+ of the lines
`ideal J=` of the E8-bar Rees scripts of gororoba-quantum, in the variables `i, s1, ..., s9` with
integer coefficients, at index `k = 0, ..., 26`. `ci/quantum-sources/e8_conjugation_ideal_lean.py`
renders them from `conjugation_map.sing` of gororoba-quantum, pinned by sha256;
`ci/quantum-sources/e8_conjugation_ideal.py` renders the same lists into
`rocq/quantum/E8ConjugationIdeal.v`. The conjugation Phi is the substitution `i -> -i, s4 -> -s5,
s5 -> s4, s7 <-> s8`, every other variable fixed, so Phi of a generator `g i s1 ... s9` is `g (-i)
s1 s2 s3 (-s5) s4 s6 s8 s7 s9`, and `phiVars` is that vector of the ten variables. The flip
negates `s3, s5, s6` (`flipVars`). Variable `0` of `Fin 10` is `i` and variable `n` is `s_n`.

## Main results

* `CayleyDickson.E8Conjugation.jm_phi`: over every commutative ring, Phi of generator `k` of J_N-
  is `phiSign k` times generator `k` of J_N+; the sign is `-1` at
  `k + 1 = 5, 7, 8, 10, 13, 16, 19, 21, 23, 26` and `+1` elsewhere.
* `CayleyDickson.E8Conjugation.jm_phi_flip`: Phi after the flip carries generator `k` of J_N- to
  generator `k` of J_N+ with no sign, so `phiSign k` is the character
  `(-1) ^ (deg s3 + deg s5 + deg s6)` of generator `k`.
* `CayleyDickson.E8Conjugation.span_phi_jm`: in `MvPolynomial (Fin 10) R` the ideal generated by
  the images of the generators of J_N- under the algebra endomorphism Phi is J_N+, and
  `span_phiFlip_jm` states it for Phi after the flip.
-/

@[expose] public section

namespace CayleyDickson.E8Conjugation

variable {A : Type*} [CommRing A]

/-- Generator `0` of the germ ideal J_N-. -/
def jmGen00 (i _s1 s2 _s3 s4 _s5 _s6 s7 s8 _s9 : A) : A :=
  8 * i * s8 + 8 * s2 * s7 + s4 ^ 2

/-- Generator `1` of the germ ideal J_N-. -/
def jmGen01 (i s1 s2 s3 _s4 s5 s6 s7 s8 s9 : A) : A :=
  -64 * i * s1 * s7 * s9 - 32 * i * s2 * s7 * s8 - 64 * i * s3 * s6 * s7 - 16 * i * s5 ^ 2 * s7 +
    16 * s2 ^ 2 * s7 ^ 2 - 16 * s8 ^ 2

/-- Generator `2` of the germ ideal J_N-. -/
def jmGen02 (i _s1 s2 _s3 _s4 s5 _s6 s7 s8 _s9 : A) : A :=
  32 * i * s2 * s7 * s8 + 16 * i * s5 ^ 2 * s7 - 16 * s2 ^ 2 * s7 ^ 2 + 16 * s8 ^ 2

/-- Generator `3` of the germ ideal J_N-. -/
def jmGen03 (i s1 s2 s3 _s4 s5 s6 s7 s8 s9 : A) : A :=
  8 * i * s1 * s2 * s7 + 8 * i * s1 * s7 * s8 - 8 * i * s2 * s7 * s9 + 8 * i * s3 * s5 * s7 -
    8 * i * s5 * s6 * s7 - 8 * i * s7 * s8 * s9 - 8 * s1 * s2 * s7 ^ 2 + 8 * s2 * s7 ^ 2 * s9 +
    8 * s5 * s6 * s7 ^ 2 + 8 * s1 * s8 + 8 * s3 * s5 - 8 * s8 * s9

/-- Generator `4` of the germ ideal J_N-. -/
def jmGen04 (i s1 s2 s3 _s4 s5 s6 s7 s8 s9 : A) : A :=
  8 * i * s1 * s5 * s7 ^ 2 - 8 * i * s2 * s3 * s7 ^ 2 + 8 * i * s2 * s6 * s7 ^ 2 +
    8 * i * s3 * s8 + 8 * i * s5 * s9 - 8 * i * s6 * s8 + 8 * s1 * s5 * s7 - 8 * s2 * s3 * s7 +
    8 * s2 * s6 * s7 - 8 * s3 * s7 * s8 - 8 * s5 * s7 * s9 + 8 * s6 * s7 * s8

/-- Generator `5` of the germ ideal J_N-. -/
def jmGen05 (i s1 s2 s3 _s4 s5 s6 s7 s8 s9 : A) : A :=
  8 * i * s1 * s2 * s7 + 8 * i * s1 * s7 * s8 + 8 * i * s2 * s7 * s9 + 8 * i * s3 * s5 * s7 +
    8 * i * s5 * s6 * s7 + 8 * i * s7 * s8 * s9 - 8 * s1 * s2 * s7 ^ 2 - 8 * s2 * s7 ^ 2 * s9 -
    8 * s5 * s6 * s7 ^ 2 + 8 * s1 * s8 + 8 * s3 * s5 + 8 * s8 * s9

/-- Generator `6` of the germ ideal J_N-. -/
def jmGen06 (i s1 s2 s3 _s4 s5 s6 s7 s8 s9 : A) : A :=
  -8 * i * s1 * s5 * s7 ^ 2 + 8 * i * s2 * s3 * s7 ^ 2 + 8 * i * s2 * s6 * s7 ^ 2 -
    8 * i * s3 * s8 + 8 * i * s5 * s9 - 8 * i * s6 * s8 - 8 * s1 * s5 * s7 + 8 * s2 * s3 * s7 +
    8 * s2 * s6 * s7 + 8 * s3 * s7 * s8 - 8 * s5 * s7 * s9 + 8 * s6 * s7 * s8

/-- Generator `7` of the germ ideal J_N-. -/
def jmGen07 (i s1 s2 s3 _s4 s5 s6 s7 s8 s9 : A) : A :=
  -16 * i * s2 * s6 * s7 ^ 2 - 16 * i * s3 * s8 - 16 * s1 * s5 * s7 + 16 * s2 * s3 * s7 +
    16 * s5 * s7 * s9 - 16 * s6 * s7 * s8

/-- Generator `8` of the germ ideal J_N-. -/
def jmGen08 (i s1 s2 s3 _s4 s5 s6 s7 s8 s9 : A) : A :=
  -16 * i * s1 * s7 * s8 + 16 * i * s2 * s7 * s9 - 16 * i * s3 * s5 * s7 + 16 * i * s5 * s6 * s7 +
    16 * s1 * s2 * s7 ^ 2 + 16 * s8 * s9

/-- Generator `9` of the germ ideal J_N-. -/
def jmGen09 (i s1 s2 s3 _s4 s5 s6 s7 s8 s9 : A) : A :=
  16 * i * s2 * s6 * s7 ^ 2 - 16 * i * s3 * s8 - 16 * s1 * s5 * s7 + 16 * s2 * s3 * s7 -
    16 * s5 * s7 * s9 + 16 * s6 * s7 * s8

/-- Generator `10` of the germ ideal J_N-. -/
def jmGen10 (i s1 s2 s3 _s4 s5 s6 s7 s8 s9 : A) : A :=
  16 * i * s1 * s7 * s8 + 16 * i * s2 * s7 * s9 + 16 * i * s3 * s5 * s7 + 16 * i * s5 * s6 * s7 -
    16 * s1 * s2 * s7 ^ 2 + 16 * s8 * s9

/-- Generator `11` of the germ ideal J_N-. -/
def jmGen11 (i s1 _s2 s3 _s4 _s5 s6 s7 _s8 s9 : A) : A :=
  -8 * i * s1 ^ 2 * s7 + 16 * i * s1 * s7 * s9 - 8 * i * s3 ^ 2 * s7 + 16 * i * s3 * s6 * s7 -
    8 * i * s6 ^ 2 * s7 - 8 * i * s7 * s9 ^ 2 + 8 * s1 ^ 2 * s7 ^ 2 - 8 * s1 * s7 ^ 2 * s9 -
    8 * s3 * s6 * s7 ^ 2 + 8 * s6 ^ 2 * s7 ^ 2 + 8 * s1 * s9 - 8 * s3 ^ 2 + 8 * s3 * s6 - 8 * s9 ^ 2

/-- Generator `12` of the germ ideal J_N-. -/
def jmGen12 (i s1 _s2 s3 _s4 _s5 s6 s7 _s8 s9 : A) : A :=
  16 * i * s1 * s6 * s7 ^ 2 + 16 * i * s3 * s9 + 16 * s1 * s6 * s7 - 16 * s3 * s7 * s9

/-- Generator `13` of the germ ideal J_N-. -/
def jmGen13 (i s1 _s2 s3 _s4 _s5 s6 s7 _s8 s9 : A) : A :=
  8 * i * s1 ^ 2 * s7 + 8 * i * s3 ^ 2 * s7 - 8 * i * s6 ^ 2 * s7 - 8 * i * s7 * s9 ^ 2 -
    8 * s1 ^ 2 * s7 ^ 2 + 8 * s1 * s7 ^ 2 * s9 + 8 * s3 * s6 * s7 ^ 2 + 8 * s6 ^ 2 * s7 ^ 2 +
    8 * s1 * s9 + 8 * s3 ^ 2 + 8 * s3 * s6 - 8 * s9 ^ 2

/-- Generator `14` of the germ ideal J_N-. -/
def jmGen14 (i s1 _s2 s3 _s4 _s5 s6 s7 _s8 s9 : A) : A :=
  8 * i * s1 ^ 2 * s7 + 8 * i * s3 ^ 2 * s7 - 8 * i * s6 ^ 2 * s7 - 8 * i * s7 * s9 ^ 2 -
    8 * s1 ^ 2 * s7 ^ 2 - 8 * s1 * s7 ^ 2 * s9 - 8 * s3 * s6 * s7 ^ 2 + 8 * s6 ^ 2 * s7 ^ 2 -
    8 * s1 * s9 + 8 * s3 ^ 2 - 8 * s3 * s6 - 8 * s9 ^ 2

/-- Generator `15` of the germ ideal J_N-. -/
def jmGen15 (i s1 _s2 s3 _s4 _s5 s6 s7 _s8 s9 : A) : A :=
  16 * i * s1 * s6 * s7 ^ 2 + 16 * i * s3 * s9 + 16 * s1 * s6 * s7 - 16 * s3 * s7 * s9

/-- Generator `16` of the germ ideal J_N-. -/
def jmGen16 (i s1 _s2 s3 _s4 _s5 s6 s7 _s8 s9 : A) : A :=
  8 * i * s1 ^ 2 * s7 + 16 * i * s1 * s7 * s9 + 8 * i * s3 ^ 2 * s7 + 16 * i * s3 * s6 * s7 +
    8 * i * s6 ^ 2 * s7 + 8 * i * s7 * s9 ^ 2 - 8 * s1 ^ 2 * s7 ^ 2 - 8 * s1 * s7 ^ 2 * s9 -
    8 * s3 * s6 * s7 ^ 2 - 8 * s6 ^ 2 * s7 ^ 2 + 8 * s1 * s9 + 8 * s3 ^ 2 + 8 * s3 * s6 + 8 * s9 ^ 2

/-- Generator `17` of the germ ideal J_N-. -/
def jmGen17 (i s1 s2 s3 _s4 s5 s6 s7 s8 s9 : A) : A :=
  -8 * i * s1 * s2 * s7 + 8 * i * s1 * s7 * s8 + 8 * i * s2 * s7 * s9 + 8 * i * s3 * s5 * s7 +
    8 * i * s5 * s6 * s7 - 8 * i * s7 * s8 * s9 - 8 * s1 * s2 * s7 ^ 2 + 8 * s2 * s7 ^ 2 * s9 +
    8 * s5 * s6 * s7 ^ 2 - 8 * s1 * s8 - 8 * s3 * s5 + 8 * s8 * s9

/-- Generator `18` of the germ ideal J_N-. -/
def jmGen18 (i s1 s2 s3 _s4 s5 s6 s7 s8 s9 : A) : A :=
  8 * i * s1 * s5 * s7 ^ 2 - 8 * i * s2 * s3 * s7 ^ 2 + 8 * i * s2 * s6 * s7 ^ 2 -
    8 * i * s3 * s8 - 8 * i * s5 * s9 + 8 * i * s6 * s8 - 8 * s1 * s5 * s7 + 8 * s2 * s3 * s7 -
    8 * s2 * s6 * s7 - 8 * s3 * s7 * s8 - 8 * s5 * s7 * s9 + 8 * s6 * s7 * s8

/-- Generator `19` of the germ ideal J_N-. -/
def jmGen19 (i s1 s2 s3 _s4 s5 s6 s7 s8 s9 : A) : A :=
  -8 * i * s1 * s2 * s7 + 8 * i * s1 * s7 * s8 - 8 * i * s2 * s7 * s9 + 8 * i * s3 * s5 * s7 -
    8 * i * s5 * s6 * s7 + 8 * i * s7 * s8 * s9 - 8 * s1 * s2 * s7 ^ 2 - 8 * s2 * s7 ^ 2 * s9 -
    8 * s5 * s6 * s7 ^ 2 - 8 * s1 * s8 - 8 * s3 * s5 - 8 * s8 * s9

/-- Generator `20` of the germ ideal J_N-. -/
def jmGen20 (i s1 s2 s3 _s4 s5 s6 s7 s8 s9 : A) : A :=
  -8 * i * s1 * s5 * s7 ^ 2 + 8 * i * s2 * s3 * s7 ^ 2 + 8 * i * s2 * s6 * s7 ^ 2 +
    8 * i * s3 * s8 - 8 * i * s5 * s9 + 8 * i * s6 * s8 + 8 * s1 * s5 * s7 - 8 * s2 * s3 * s7 -
    8 * s2 * s6 * s7 + 8 * s3 * s7 * s8 - 8 * s5 * s7 * s9 + 8 * s6 * s7 * s8

/-- Generator `21` of the germ ideal J_N-. -/
def jmGen21 (i s1 _s2 s3 _s4 _s5 s6 s7 _s8 s9 : A) : A :=
  -8 * i * s1 ^ 2 * s7 + 8 * i * s3 ^ 2 * s7 - 8 * i * s6 ^ 2 * s7 + 8 * i * s7 * s9 ^ 2 -
    8 * s1 ^ 2 * s7 ^ 2 + 8 * s1 * s7 ^ 2 * s9 + 8 * s3 * s6 * s7 ^ 2 - 8 * s6 ^ 2 * s7 ^ 2 +
    8 * s1 * s9 - 8 * s3 ^ 2 + 8 * s3 * s6 - 8 * s9 ^ 2

/-- Generator `22` of the germ ideal J_N-. -/
def jmGen22 (i s1 _s2 s3 _s4 _s5 s6 s7 _s8 s9 : A) : A :=
  -16 * i * s1 * s6 * s7 ^ 2 + 16 * i * s3 * s9 + 16 * s1 * s6 * s7 + 16 * s3 * s7 * s9

/-- Generator `23` of the germ ideal J_N-. -/
def jmGen23 (i s1 _s2 s3 _s4 _s5 s6 s7 _s8 s9 : A) : A :=
  8 * i * s1 ^ 2 * s7 - 16 * i * s1 * s7 * s9 - 8 * i * s3 ^ 2 * s7 - 16 * i * s3 * s6 * s7 -
    8 * i * s6 ^ 2 * s7 + 8 * i * s7 * s9 ^ 2 + 8 * s1 ^ 2 * s7 ^ 2 - 8 * s1 * s7 ^ 2 * s9 -
    8 * s3 * s6 * s7 ^ 2 - 8 * s6 ^ 2 * s7 ^ 2 + 8 * s1 * s9 + 8 * s3 ^ 2 + 8 * s3 * s6 - 8 * s9 ^ 2

/-- Generator `24` of the germ ideal J_N-. -/
def jmGen24 (i s1 _s2 s3 _s4 _s5 s6 s7 _s8 s9 : A) : A :=
  8 * i * s1 ^ 2 * s7 + 16 * i * s1 * s7 * s9 - 8 * i * s3 ^ 2 * s7 + 16 * i * s3 * s6 * s7 -
    8 * i * s6 ^ 2 * s7 + 8 * i * s7 * s9 ^ 2 + 8 * s1 ^ 2 * s7 ^ 2 + 8 * s1 * s7 ^ 2 * s9 +
    8 * s3 * s6 * s7 ^ 2 - 8 * s6 ^ 2 * s7 ^ 2 - 8 * s1 * s9 + 8 * s3 ^ 2 - 8 * s3 * s6 - 8 * s9 ^ 2

/-- Generator `25` of the germ ideal J_N-. -/
def jmGen25 (i s1 _s2 s3 _s4 _s5 s6 s7 _s8 s9 : A) : A :=
  -16 * i * s1 * s6 * s7 ^ 2 + 16 * i * s3 * s9 + 16 * s1 * s6 * s7 + 16 * s3 * s7 * s9

/-- Generator `26` of the germ ideal J_N-. -/
def jmGen26 (i s1 _s2 s3 _s4 _s5 s6 s7 _s8 s9 : A) : A :=
  8 * i * s1 ^ 2 * s7 - 8 * i * s3 ^ 2 * s7 + 8 * i * s6 ^ 2 * s7 - 8 * i * s7 * s9 ^ 2 +
    8 * s1 ^ 2 * s7 ^ 2 + 8 * s1 * s7 ^ 2 * s9 + 8 * s3 * s6 * s7 ^ 2 + 8 * s6 ^ 2 * s7 ^ 2 +
    8 * s1 * s9 + 8 * s3 ^ 2 + 8 * s3 * s6 + 8 * s9 ^ 2

/-- The `k`-th generator of the germ ideal J_N- (`k = 0, ..., 26`). -/
def jm (i s1 s2 s3 s4 s5 s6 s7 s8 s9 : A) : Fin 27 → A :=
  ![
    jmGen00 i s1 s2 s3 s4 s5 s6 s7 s8 s9,
    jmGen01 i s1 s2 s3 s4 s5 s6 s7 s8 s9,
    jmGen02 i s1 s2 s3 s4 s5 s6 s7 s8 s9,
    jmGen03 i s1 s2 s3 s4 s5 s6 s7 s8 s9,
    jmGen04 i s1 s2 s3 s4 s5 s6 s7 s8 s9,
    jmGen05 i s1 s2 s3 s4 s5 s6 s7 s8 s9,
    jmGen06 i s1 s2 s3 s4 s5 s6 s7 s8 s9,
    jmGen07 i s1 s2 s3 s4 s5 s6 s7 s8 s9,
    jmGen08 i s1 s2 s3 s4 s5 s6 s7 s8 s9,
    jmGen09 i s1 s2 s3 s4 s5 s6 s7 s8 s9,
    jmGen10 i s1 s2 s3 s4 s5 s6 s7 s8 s9,
    jmGen11 i s1 s2 s3 s4 s5 s6 s7 s8 s9,
    jmGen12 i s1 s2 s3 s4 s5 s6 s7 s8 s9,
    jmGen13 i s1 s2 s3 s4 s5 s6 s7 s8 s9,
    jmGen14 i s1 s2 s3 s4 s5 s6 s7 s8 s9,
    jmGen15 i s1 s2 s3 s4 s5 s6 s7 s8 s9,
    jmGen16 i s1 s2 s3 s4 s5 s6 s7 s8 s9,
    jmGen17 i s1 s2 s3 s4 s5 s6 s7 s8 s9,
    jmGen18 i s1 s2 s3 s4 s5 s6 s7 s8 s9,
    jmGen19 i s1 s2 s3 s4 s5 s6 s7 s8 s9,
    jmGen20 i s1 s2 s3 s4 s5 s6 s7 s8 s9,
    jmGen21 i s1 s2 s3 s4 s5 s6 s7 s8 s9,
    jmGen22 i s1 s2 s3 s4 s5 s6 s7 s8 s9,
    jmGen23 i s1 s2 s3 s4 s5 s6 s7 s8 s9,
    jmGen24 i s1 s2 s3 s4 s5 s6 s7 s8 s9,
    jmGen25 i s1 s2 s3 s4 s5 s6 s7 s8 s9,
    jmGen26 i s1 s2 s3 s4 s5 s6 s7 s8 s9]

/-- Generator `0` of the germ ideal J_N+. -/
def jpGen00 (i _s1 s2 _s3 _s4 s5 _s6 s7 s8 _s9 : A) : A :=
  -8 * i * s7 + 8 * s2 * s8 + s5 ^ 2

/-- Generator `1` of the germ ideal J_N+. -/
def jpGen01 (i s1 s2 s3 s4 _s5 s6 s7 s8 s9 : A) : A :=
  64 * i * s1 * s8 * s9 + 32 * i * s2 * s7 * s8 + 64 * i * s3 * s6 * s8 + 16 * i * s4 ^ 2 * s8 +
    16 * s2 ^ 2 * s8 ^ 2 - 16 * s7 ^ 2

/-- Generator `2` of the germ ideal J_N+. -/
def jpGen02 (i _s1 s2 _s3 s4 _s5 _s6 s7 s8 _s9 : A) : A :=
  -32 * i * s2 * s7 * s8 - 16 * i * s4 ^ 2 * s8 - 16 * s2 ^ 2 * s8 ^ 2 + 16 * s7 ^ 2

/-- Generator `3` of the germ ideal J_N+. -/
def jpGen03 (i s1 s2 s3 s4 _s5 s6 s7 s8 s9 : A) : A :=
  -8 * i * s1 * s2 * s8 - 8 * i * s1 * s7 * s8 + 8 * i * s2 * s8 * s9 - 8 * i * s3 * s4 * s8 +
    8 * i * s4 * s6 * s8 + 8 * i * s7 * s8 * s9 - 8 * s1 * s2 * s8 ^ 2 + 8 * s2 * s8 ^ 2 * s9 +
    8 * s4 * s6 * s8 ^ 2 + 8 * s1 * s7 + 8 * s3 * s4 - 8 * s7 * s9

/-- Generator `4` of the germ ideal J_N+. -/
def jpGen04 (i s1 s2 s3 s4 _s5 s6 s7 s8 s9 : A) : A :=
  8 * i * s1 * s4 * s8 ^ 2 - 8 * i * s2 * s3 * s8 ^ 2 + 8 * i * s2 * s6 * s8 ^ 2 +
    8 * i * s3 * s7 + 8 * i * s4 * s9 - 8 * i * s6 * s7 - 8 * s1 * s4 * s8 + 8 * s2 * s3 * s8 -
    8 * s2 * s6 * s8 + 8 * s3 * s7 * s8 + 8 * s4 * s8 * s9 - 8 * s6 * s7 * s8

/-- Generator `5` of the germ ideal J_N+. -/
def jpGen05 (i s1 s2 s3 s4 _s5 s6 s7 s8 s9 : A) : A :=
  -8 * i * s1 * s2 * s8 - 8 * i * s1 * s7 * s8 - 8 * i * s2 * s8 * s9 - 8 * i * s3 * s4 * s8 -
    8 * i * s4 * s6 * s8 - 8 * i * s7 * s8 * s9 - 8 * s1 * s2 * s8 ^ 2 - 8 * s2 * s8 ^ 2 * s9 -
    8 * s4 * s6 * s8 ^ 2 + 8 * s1 * s7 + 8 * s3 * s4 + 8 * s7 * s9

/-- Generator `6` of the germ ideal J_N+. -/
def jpGen06 (i s1 s2 s3 s4 _s5 s6 s7 s8 s9 : A) : A :=
  -8 * i * s1 * s4 * s8 ^ 2 + 8 * i * s2 * s3 * s8 ^ 2 + 8 * i * s2 * s6 * s8 ^ 2 -
    8 * i * s3 * s7 + 8 * i * s4 * s9 - 8 * i * s6 * s7 + 8 * s1 * s4 * s8 - 8 * s2 * s3 * s8 -
    8 * s2 * s6 * s8 - 8 * s3 * s7 * s8 + 8 * s4 * s8 * s9 - 8 * s6 * s7 * s8

/-- Generator `7` of the germ ideal J_N+. -/
def jpGen07 (i s1 s2 s3 s4 _s5 s6 s7 s8 s9 : A) : A :=
  -16 * i * s2 * s6 * s8 ^ 2 - 16 * i * s3 * s7 + 16 * s1 * s4 * s8 - 16 * s2 * s3 * s8 -
    16 * s4 * s8 * s9 + 16 * s6 * s7 * s8

/-- Generator `8` of the germ ideal J_N+. -/
def jpGen08 (i s1 s2 s3 s4 _s5 s6 s7 s8 s9 : A) : A :=
  16 * i * s1 * s7 * s8 - 16 * i * s2 * s8 * s9 + 16 * i * s3 * s4 * s8 - 16 * i * s4 * s6 * s8 +
    16 * s1 * s2 * s8 ^ 2 + 16 * s7 * s9

/-- Generator `9` of the germ ideal J_N+. -/
def jpGen09 (i s1 s2 s3 s4 _s5 s6 s7 s8 s9 : A) : A :=
  16 * i * s2 * s6 * s8 ^ 2 - 16 * i * s3 * s7 + 16 * s1 * s4 * s8 - 16 * s2 * s3 * s8 +
    16 * s4 * s8 * s9 - 16 * s6 * s7 * s8

/-- Generator `10` of the germ ideal J_N+. -/
def jpGen10 (i s1 s2 s3 s4 _s5 s6 s7 s8 s9 : A) : A :=
  -16 * i * s1 * s7 * s8 - 16 * i * s2 * s8 * s9 - 16 * i * s3 * s4 * s8 - 16 * i * s4 * s6 * s8 -
    16 * s1 * s2 * s8 ^ 2 + 16 * s7 * s9

/-- Generator `11` of the germ ideal J_N+. -/
def jpGen11 (i s1 _s2 s3 _s4 _s5 s6 _s7 s8 s9 : A) : A :=
  8 * i * s1 ^ 2 * s8 - 16 * i * s1 * s8 * s9 + 8 * i * s3 ^ 2 * s8 - 16 * i * s3 * s6 * s8 +
    8 * i * s6 ^ 2 * s8 + 8 * i * s8 * s9 ^ 2 + 8 * s1 ^ 2 * s8 ^ 2 - 8 * s1 * s8 ^ 2 * s9 -
    8 * s3 * s6 * s8 ^ 2 + 8 * s6 ^ 2 * s8 ^ 2 + 8 * s1 * s9 - 8 * s3 ^ 2 + 8 * s3 * s6 - 8 * s9 ^ 2

/-- Generator `12` of the germ ideal J_N+. -/
def jpGen12 (i s1 _s2 s3 _s4 _s5 s6 _s7 s8 s9 : A) : A :=
  16 * i * s1 * s6 * s8 ^ 2 + 16 * i * s3 * s9 - 16 * s1 * s6 * s8 + 16 * s3 * s8 * s9

/-- Generator `13` of the germ ideal J_N+. -/
def jpGen13 (i s1 _s2 s3 _s4 _s5 s6 _s7 s8 s9 : A) : A :=
  -8 * i * s1 ^ 2 * s8 - 8 * i * s3 ^ 2 * s8 + 8 * i * s6 ^ 2 * s8 + 8 * i * s8 * s9 ^ 2 -
    8 * s1 ^ 2 * s8 ^ 2 + 8 * s1 * s8 ^ 2 * s9 + 8 * s3 * s6 * s8 ^ 2 + 8 * s6 ^ 2 * s8 ^ 2 +
