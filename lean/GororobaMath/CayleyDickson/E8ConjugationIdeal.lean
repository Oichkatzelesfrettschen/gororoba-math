/-- Phi of generator `25` of J_N- is `-1` times generator `25` of J_N+. -/
theorem jm_phi_gen25 (i s1 s2 s3 s4 s5 s6 s7 s8 s9 : A) :
    jmGen25 (-i) s1 s2 s3 (-s5) s4 s6 s8 s7 s9 =
      (-1 : A) * jpGen25 i s1 s2 s3 s4 s5 s6 s7 s8 s9 := by
  unfold jmGen25 jpGen25
  ring

/-- Phi after the flip carries generator `25` of J_N- to generator `25` of J_N+. -/
