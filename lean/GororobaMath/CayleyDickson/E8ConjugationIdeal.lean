    jmGen25 (-i) s1 s2 (-s3) (-s5) (-s4) (-s6) s8 s7 s9 =
      jpGen25 i s1 s2 s3 s4 s5 s6 s7 s8 s9 := by
  unfold jmGen25 jpGen25
  ring

/-- A ring homomorphism carries generator `25` of J_N- at the ten variables to the one at their
images. -/
theorem map_jmGen25 {B : Type*} [CommRing B] {F : Type*} [FunLike F A B] [RingHomClass F A B]
    (f : F) (i s1 s2 s3 s4 s5 s6 s7 s8 s9 : A) :
    f (jmGen25 i s1 s2 s3 s4 s5 s6 s7 s8 s9) =
      jmGen25 (f i) (f s1) (f s2) (f s3) (f s4) (f s5) (f s6) (f s7) (f s8) (f s9) := by
  simp [jmGen25, map_ofNat f]

