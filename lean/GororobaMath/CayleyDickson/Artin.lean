module

public import GororobaMath.CayleyDickson.AlternativeIdentities

/-!
# Artin's theorem for the tower at levels up to 3, and its failure from level 4

Convention: the product of `Tower R k` is the Cayley-Dickson product
`(a, b) (c, d) = (a c - star d b, d a + b star c)` of `GororobaMath.CayleyDickson.Basic` and the
associator is `associator a b c = (a * b) * c - a * (b * c)`. The level results read over a
commutative ring `R` with the identity as star; `Tower.twoGenSpan a b` is the `R`-span of
`1`, `a`, `b` and `a * b`.

## Main results

* `Tower.twoGenSpan_mul_mem`: at levels up to 3 the span of `1`, `a`, `b`, `a * b` is closed under
  the product, since `b a` is a combination of `1`, `a`, `b` and `a b`
  (the quadratic law of `Tower.mul_self_eq_smul_sub`, polarized).
* `Tower.associator_eq_zero_of_mem_twoGenSpan`: the associator vanishes on that span, because
  `A(a, b, a b) = 0`.
* `Tower.associator_eq_zero_of_mem_closure_pair`: Artin's theorem for the tower at levels up to 3:
  the associator vanishes on the non-unital subring generated by two elements.
-/

@[expose] public section

namespace CayleyDickson

namespace Tower

universe u

section Span

variable {R : Type u} [CommRing R] [StarRing R] [TrivialStar R] {k : ℕ}

/-- Closure of a span under the product from the products of a spanning set. -/
theorem mul_mem_span_of_basis {T : Set (Tower R k)}
    (h : ∀ u ∈ T, ∀ v ∈ T, u * v ∈ Submodule.span R T) {x y : Tower R k}
    (hx : x ∈ Submodule.span R T) (hy : y ∈ Submodule.span R T) : x * y ∈ Submodule.span R T := by
  induction hx using Submodule.span_induction with
  | mem u hu =>
    induction hy using Submodule.span_induction with
    | mem v hv => exact h u hu v hv
    | zero => rw [mul_zero]; exact zero_mem _
    | add v w _ _ hv hw => rw [mul_add]; exact add_mem hv hw
    | smul r v _ hv => rw [mul_smul_comm']; exact Submodule.smul_mem _ _ hv
  | zero => rw [zero_mul]; exact zero_mem _
  | add u w _ _ hu hw => rw [add_mul]; exact add_mem hu hw
  | smul r u _ hu => rw [smul_mul_assoc']; exact Submodule.smul_mem _ _ hu

/-- Right multiplication by `w` maps the span of `T` into `Q` when it does so on `T`. -/
theorem mul_right_mem_span {T : Set (Tower R k)} {w : Tower R k} {Q : Submodule R (Tower R k)}
    (h : ∀ u ∈ T, u * w ∈ Q) {x : Tower R k} (hx : x ∈ Submodule.span R T) : x * w ∈ Q := by
  induction hx using Submodule.span_induction with
  | mem u hu => exact h u hu
  | zero => rw [zero_mul]; exact zero_mem _
  | add u v _ _ hu hv => rw [add_mul]; exact add_mem hu hv
  | smul r u _ hu => rw [smul_mul_assoc']; exact Submodule.smul_mem _ _ hu

/-- Left multiplication by `w` maps the span of `T` into `Q` when it does so on `T`. -/
theorem mul_left_mem_span {T : Set (Tower R k)} {w : Tower R k} {Q : Submodule R (Tower R k)}
    (h : ∀ u ∈ T, w * u ∈ Q) {x : Tower R k} (hx : x ∈ Submodule.span R T) : w * x ∈ Q := by
  induction hx using Submodule.span_induction with
  | mem u hu => exact h u hu
  | zero => rw [mul_zero]; exact zero_mem _
  | add u v _ _ hu hv => rw [mul_add]; exact add_mem hu hv
  | smul r u _ hu => rw [mul_smul_comm']; exact Submodule.smul_mem _ _ hu

/-- The associator vanishes on a span when it vanishes on the spanning set. -/
theorem associator_eq_zero_of_span {T : Set (Tower R k)}
    (h : ∀ u ∈ T, ∀ v ∈ T, ∀ w ∈ T, associator u v w = 0) {x y z : Tower R k}
    (hx : x ∈ Submodule.span R T) (hy : y ∈ Submodule.span R T) (hz : z ∈ Submodule.span R T) :
    associator x y z = 0 := by
  induction hx using Submodule.span_induction with
  | mem u hu =>
    induction hy using Submodule.span_induction with
    | mem v hv =>
      induction hz using Submodule.span_induction with
      | mem w hw => exact h u hu v hv w hw
      | zero => simp [associator]
      | add w w' _ _ hw hw' => rw [associator_add_right, hw, hw', add_zero]
      | smul r w _ hw => rw [associator_smul_right, hw, smul_zero]
    | zero => simp [associator]
    | add v v' _ _ hv hv' => rw [associator_add_mid, hv, hv', add_zero]
    | smul r v _ hv => rw [associator_smul_mid, hv, smul_zero]
  | zero => simp [associator]
  | add u u' _ _ hu hu' => rw [associator_add_left, hu, hu', add_zero]
  | smul r u _ hu => rw [associator_smul_left, hu, smul_zero]

end Span

section TwoGenerated

variable {R : Type u} [CommRing R] [StarRing R] [TrivialStar R] {k : ℕ}

/-- The `R`-span of `1`, `a`, `b` and `a * b`. -/
def twoGenSpan (a b : Tower R k) : Submodule R (Tower R k) :=
  Submodule.span R {1, a, b, a * b}

/-- The `R`-span of `1`, `a` and `b`. -/
def oneStepSpan (a b : Tower R k) : Submodule R (Tower R k) := Submodule.span R {1, a, b}

theorem mul_self_mem {Q : Submodule R (Tower R k)} (h1 : (1 : Tower R k) ∈ Q) {x : Tower R k}
    (hx : x ∈ Q) : x * x ∈ Q := by
  rw [mul_self_eq_smul_sub]
  exact sub_mem (Q.smul_mem _ hx) (Q.smul_mem _ h1)

/-- The span of `1`, `a`, `b` and `a * b` is closed under the product at levels up to 3. -/
theorem twoGenSpan_mul_mem (hk : k ≤ 3) (a b : Tower R k) {x y : Tower R k}
    (hx : x ∈ twoGenSpan a b) (hy : y ∈ twoGenSpan a b) : x * y ∈ twoGenSpan a b := by
  have h1 : (1 : Tower R k) ∈ twoGenSpan a b := Submodule.subset_span (by simp)
  have ha : a ∈ twoGenSpan a b := Submodule.subset_span (by simp)
  have hb : b ∈ twoGenSpan a b := Submodule.subset_span (by simp)
  have hab : a * b ∈ twoGenSpan a b := Submodule.subset_span (by simp)
  have hSQ : oneStepSpan a b ≤ twoGenSpan a b := by
    refine Submodule.span_le.2 fun z hz => ?_
    simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hz
    rcases hz with rfl | rfl | rfl
    · exact h1
    · exact ha
    · exact hb
  have hS1 : (1 : Tower R k) ∈ oneStepSpan a b := Submodule.subset_span (by simp)
  have haS : a ∈ oneStepSpan a b := Submodule.subset_span (by simp)
  have hbS : b ∈ oneStepSpan a b := Submodule.subset_span (by simp)
  have hsq : ∀ z ∈ oneStepSpan a b, z * z ∈ oneStepSpan a b := fun z hz => mul_self_mem hS1 hz
  have hs : (a + b) * (a + b) - a * a - b * b ∈ oneStepSpan a b :=
    sub_mem (sub_mem (hsq _ (add_mem haS hbS)) (hsq a haS)) (hsq b hbS)
  have hba_eq : b * a = ((a + b) * (a + b) - a * a - b * b) - a * b := by
    simp only [add_mul, mul_add]
    abel
  have hba : b * a ∈ twoGenSpan a b := by
    rw [hba_eq]
    exact sub_mem (hSQ hs) hab
  have hSb : ∀ z ∈ oneStepSpan a b, z * b ∈ twoGenSpan a b := fun z hz =>
    mul_right_mem_span (T := {1, a, b}) (fun u hu => by
      simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hu
      rcases hu with rfl | rfl | rfl
      · rw [one_mul]; exact hb
      · exact hab
      · exact hSQ (hsq _ hbS)) hz
  have haS' : ∀ z ∈ oneStepSpan a b, a * z ∈ twoGenSpan a b := fun z hz =>
    mul_left_mem_span (T := {1, a, b}) (fun u hu => by
      simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hu
      rcases hu with rfl | rfl | rfl
      · rw [mul_one]; exact ha
      · exact hSQ (hsq _ haS)
      · exact hab) hz
  have hbb : (a * b) * b ∈ twoGenSpan a b := by
    rw [right_alternative_of_le_three hk b a]
    exact haS' _ (hsq _ hbS)
  have haab : a * (a * b) ∈ twoGenSpan a b := by
    rw [left_alternative_of_le_three hk a b]
    exact hSb _ (hsq _ haS)
  refine mul_mem_span_of_basis (T := {1, a, b, a * b}) ?_ hx hy
  intro u hu v hv
  simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hu hv
  rcases hu with hu | hu | hu | hu <;> rcases hv with hv | hv | hv | hv <;> rw [hu, hv]
  · rw [one_mul]; exact h1
  · rw [one_mul]; exact ha
  · rw [one_mul]; exact hb
  · rw [one_mul]; exact hab
  · rw [mul_one]; exact ha
  · exact mul_self_mem h1 ha
  · exact hab
  · exact haab
  · rw [mul_one]; exact hb
  · exact hba
  · exact mul_self_mem h1 hb
  · rw [← flexible_of_le_three hk b a, hba_eq, sub_mul]
    exact sub_mem (hSb _ hs) hbb
  · rw [mul_one]; exact hab
  · rw [flexible_of_le_three hk a b, hba_eq, mul_sub]
    exact sub_mem (haS' _ hs) haab
  · exact hbb
  · exact mul_self_mem h1 hab

/-- The associator `A(a, b, a b)` vanishes at levels up to 3. -/
theorem associator_self_mul_of_le_three (hk : k ≤ 3) (a b : Tower R k) :
    associator a b (a * b) = 0 := by
  have h : associator a (a * b) b = 0 := by
    unfold associator
    rw [left_alternative_of_le_three hk a b, right_alternative_of_le_three hk b (a * a),
      right_alternative_of_le_three hk b a, left_alternative_of_le_three hk a (b * b)]
    exact sub_self _
  rw [eq_neg_of_add_eq_zero_left (associator_add_swap_right_of_le_three hk a b (a * b)), h,
    neg_zero]

/-- The associator vanishes on the span of `1`, `a`, `b` and `a * b` at levels up to 3. -/
theorem associator_eq_zero_of_mem_twoGenSpan (hk : k ≤ 3) (a b : Tower R k) {x y z : Tower R k}
    (hx : x ∈ twoGenSpan a b) (hy : y ∈ twoGenSpan a b) (hz : z ∈ twoGenSpan a b) :
    associator x y z = 0 := by
  have h1 := associator_self_mul_of_le_three hk a b
  have h2 : associator a (a * b) b = 0 := by
    rw [eq_neg_of_add_eq_zero_right (associator_add_swap_right_of_le_three hk a b (a * b)), h1,
      neg_zero]
  have h3 : associator b a (a * b) = 0 := by
    rw [eq_neg_of_add_eq_zero_right (associator_add_swap_left_of_le_three hk a b (a * b)), h1,
      neg_zero]
  have h4 : associator b (a * b) a = 0 := by
    rw [← associator_cyclic_of_le_three hk a b (a * b), h1]
  have h5 : associator (a * b) a b = 0 := by
    rw [← associator_cyclic_of_le_three hk b (a * b) a, h4]
  have h6 : associator (a * b) b a = 0 := by
    rw [eq_neg_of_add_eq_zero_right (associator_add_swap_right_of_le_three hk (a * b) a b), h5,
      neg_zero]
  have hl := associator_self_left_of_le_three (R := R) hk
  have hr := associator_self_right_of_le_three (R := R) hk
  have hf : ∀ x y : Tower R k, associator x y x = 0 := fun x y => by
    rw [associator_cyclic_of_le_three hk x y x, hr]
  refine associator_eq_zero_of_span ?_ hx hy hz
  intro u hu v hv w hw
  simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hu hv hw
  rcases hu with hu | hu | hu | hu <;> rcases hv with hv | hv | hv | hv <;>
    rcases hw with hw | hw | hw | hw <;> rw [hu, hv, hw] <;>
    simp [hl, hr, hf, h1, h2, h3, h4, h5, h6]

/-- Artin's theorem for the tower at levels up to 3: the associator vanishes on the non-unital
subring generated by two elements. -/
theorem associator_eq_zero_of_mem_closure_pair (hk : k ≤ 3) (a b : Tower R k) {x y z : Tower R k}
    (hx : x ∈ NonUnitalSubring.closure ({a, b} : Set (Tower R k)))
    (hy : y ∈ NonUnitalSubring.closure ({a, b} : Set (Tower R k)))
    (hz : z ∈ NonUnitalSubring.closure ({a, b} : Set (Tower R k))) :
    associator x y z = 0 := by
  have hQ : ∀ {w : Tower R k}, w ∈ NonUnitalSubring.closure ({a, b} : Set (Tower R k)) →
      w ∈ twoGenSpan a b := by
    intro w hw
    induction hw using NonUnitalSubring.closure_induction with
    | mem w hw =>
      simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hw
      rcases hw with rfl | rfl
      · exact Submodule.subset_span (by simp)
      · exact Submodule.subset_span (by simp)
    | zero => exact zero_mem _
    | add u v _ _ hu hv => exact add_mem hu hv
    | neg u _ hu => exact neg_mem hu
    | mul u v _ _ hu hv => exact twoGenSpan_mul_mem hk a b hu hv
  exact associator_eq_zero_of_mem_twoGenSpan hk a b (hQ hx) (hQ hy) (hQ hz)

end TwoGenerated

section Failure

theorem associator_zsmul_right {A : Type*} [NonAssocRing A] (n : ℤ) (a b c : A) :
    associator a b (n • c) = n • associator a b c := by
  simp only [associator, mul_smul_comm, smul_sub]

variable {R : Type u} [CommRing R] [StarRing R]

/-- The coordinate of `A(a, b, a b)` at `e 6` for the sedenion sums `a = e 1 + e 10` and
`b = e 1 + e 12` is `-2`; the associator is `-2 e 6 - 2 e 13`. -/
theorem associator_pair_witness_dot :
    dot 4 (associator (e R 4 1#4 + e R 4 10#4) (e R 4 1#4 + e R 4 12#4)
      ((e R 4 1#4 + e R 4 10#4) * (e R 4 1#4 + e R 4 12#4))) (e R 4 6#4) = -2 := by
  have s1 : sign 4 1#4 1#4 = -1 := by decide
  have s2 : sign 4 10#4 1#4 = 1 := by decide
  have s3 : sign 4 1#4 12#4 = -1 := by decide
  have s4 : sign 4 10#4 12#4 = -1 := by decide
  have c1 : basisAssocCoeff 4 10#4 12#4 0#4 = 0 := by decide
  have c2 : basisAssocCoeff 4 1#4 12#4 11#4 = 0 := by decide
  have c3 : basisAssocCoeff 4 10#4 1#4 13#4 = 2 := by decide
  have c4 : basisAssocCoeff 4 1#4 1#4 6#4 = 0 := by decide
  simp (config := {decide := true}) only [add_mul, mul_add, e_mul_e_sign, associator_add_left,
    associator_add_mid, associator_add_right, associator_zsmul_right, associator_e_e_e,
    dot_add_left, dot_zsmul_left, dot_e_e, BitVec.reduceXOr]
  simp [s1, s2, s3, s4, c1, c2, c3, c4]

/-- At every level `k ≥ 4`, over a ring with `2 ≠ 0`, `A(a, b, a b)` is nonzero for the images
`a = e 1 + e 10` and `b = e 1 + e 12` of two sedenion sums. -/
theorem exists_associator_self_mul_ne (h2 : (2 : R) ≠ 0) (k : ℕ) (hk : 4 ≤ k) :
    ∃ a b : Tower R k, associator a b (a * b) ≠ 0 := by
  obtain ⟨m, rfl⟩ := Nat.exists_eq_add_of_le hk
  refine ⟨lift 4 m (e R 4 1#4 + e R 4 10#4), lift 4 m (e R 4 1#4 + e R 4 12#4), ?_⟩
  rw [← lift_mul, ← lift_associator]
  intro h
  have h4 := lift_injective 4 m (h.trans (lift_zero 4 m).symm)
  have h5 := congrArg (fun z => dot 4 z (e R 4 6#4)) h4
  simp only [associator_pair_witness_dot, dot_zero_left] at h5
  exact h2 (neg_eq_zero.1 h5)

/-- At every level `k ≥ 4`, over a ring with `2 ≠ 0`, the non-unital subring generated by two
elements holds three elements with nonzero associator, namely `a`, `b` and `a * b`. -/
theorem exists_associator_ne_of_mem_closure_pair (h2 : (2 : R) ≠ 0) (k : ℕ) (hk : 4 ≤ k) :
    ∃ a b : Tower R k, ∃ x ∈ NonUnitalSubring.closure ({a, b} : Set (Tower R k)),
      ∃ y ∈ NonUnitalSubring.closure ({a, b} : Set (Tower R k)),
        ∃ z ∈ NonUnitalSubring.closure ({a, b} : Set (Tower R k)), associator x y z ≠ 0 := by
  obtain ⟨a, b, h⟩ := exists_associator_self_mul_ne h2 k hk
  have ha : a ∈ NonUnitalSubring.closure ({a, b} : Set (Tower R k)) :=
    NonUnitalSubring.subset_closure (by simp)
  have hb : b ∈ NonUnitalSubring.closure ({a, b} : Set (Tower R k)) :=
    NonUnitalSubring.subset_closure (by simp)
  exact ⟨a, b, a, ha, b, hb, a * b, mul_mem ha hb, h⟩

end Failure

end Tower

end CayleyDickson
