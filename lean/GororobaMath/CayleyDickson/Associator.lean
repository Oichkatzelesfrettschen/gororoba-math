module

public import GororobaMath.CayleyDickson.Map
public import GororobaMath.CayleyDickson.Quaternion
public import GororobaMath.CayleyDickson.TraceForm

/-!
# The associator of the Cayley-Dickson tower

Convention: the associator of three elements is `associator a b c = (a * b) * c - a * (b * c)`,
the product of the double being `(a, b) * (c, d) = (a * c - star d * b, d * a + b * star c)`
(`GororobaMath.CayleyDickson.Basic`). The scalar results read in the context of
`TowerModule.lean`: a commutative ring `R` with the identity as star, acting on `Tower R k`
by `•`; the additive and star results hold over every non-associative ring.

## Main results

* `CayleyDickson.associator_add_left`, `associator_add_mid`, `associator_add_right`,
  `associator_neg_left`, `associator_sub_left` and their mirrors, and, at every level
  `Tower R k`, `Tower.associator_smul_left`, `associator_smul_mid`, `associator_smul_right`:
  the associator is trilinear. The Rocq partial originals are `pathion_assoc_trilinear_scale_1`
  of `rocq/open/verified/C1470_PathionTrilinearity.v`, `cd16384_assoc_trilinear` of
  `rocq/open/verified/C1471_HigherCDTrilinearity.v` and `oct_mul_add_left` of
  `rocq/open/theories/CDLinearLemmas.v`, each at one level and one slot.
* `CayleyDickson.associator_commutator_right`: `A(a, b, c d - d c) = A(a, b, c d) - A(a, b, d c)`.
* `CayleyDickson.associator_one_left`, `associator_one_mid`, `associator_one_right`: the
  associator with the identity vanishes.
* `CayleyDickson.star_associator`: conjugation reverses the associator,
  `star A(a, b, c) = -A(star c, star b, star a)`; `Tower.associator_star`: with `2` left regular
  in `R`, `star A(a, b, c) = A(star a, star b, star c)` at every level, by the flexible law.
* `Tower.associator_star_rev_sub_star`: `A(star c, star b, star a) - star A(a, b, c)` is twice
  `A(star c, star b, star a)`; `Tower.associator_two`: the associator vanishes at level 2.
* `Tower.associator_self_self_self`, `Tower.associator_span_one_self`: power-associativity, the
  subalgebra `R 1 + R x` generated by one element is associative, at every level over every
  commutative ring with the identity as star.
* `Tower.associator_lift_two`: the quaternionic subalgebra is associative inside every higher level.
-/

@[expose] public section

namespace CayleyDickson

/-- The associator `(a * b) * c - a * (b * c)`. -/
def associator {A : Type*} [Mul A] [Sub A] (a b c : A) : A := a * b * c - a * (b * c)

section Additive

variable {A : Type*} [NonAssocRing A]

theorem associator_add_left (a a' b c : A) :
    associator (a + a') b c = associator a b c + associator a' b c := by
  simp only [associator, add_mul]; abel

theorem associator_add_mid (a b b' c : A) :
    associator a (b + b') c = associator a b c + associator a b' c := by
  simp only [associator, add_mul, mul_add]; abel

theorem associator_add_right (a b c c' : A) :
    associator a b (c + c') = associator a b c + associator a b c' := by
  simp only [associator, mul_add]; abel

theorem associator_neg_left (a b c : A) : associator (-a) b c = -associator a b c := by
  simp only [associator, neg_mul]; abel

theorem associator_neg_mid (a b c : A) : associator a (-b) c = -associator a b c := by
  simp only [associator, neg_mul, mul_neg]; abel

theorem associator_neg_right (a b c : A) : associator a b (-c) = -associator a b c := by
  simp only [associator, mul_neg]; abel

theorem associator_sub_left (a a' b c : A) :
    associator (a - a') b c = associator a b c - associator a' b c := by
  simp only [associator, sub_mul]; abel

theorem associator_sub_mid (a b b' c : A) :
    associator a (b - b') c = associator a b c - associator a b' c := by
  simp only [associator, sub_mul, mul_sub]; abel

theorem associator_sub_right (a b c c' : A) :
    associator a b (c - c') = associator a b c - associator a b c' := by
  simp only [associator, mul_sub]; abel

/-- The associator with the identity in the first slot vanishes. -/
@[simp] theorem associator_one_left (b c : A) : associator 1 b c = 0 := by
  simp [associator]

/-- The associator with the identity in the middle slot vanishes. -/
@[simp] theorem associator_one_mid (a c : A) : associator a 1 c = 0 := by
  simp [associator]

/-- The associator with the identity in the last slot vanishes. -/
@[simp] theorem associator_one_right (a b : A) : associator a b 1 = 0 := by
  simp [associator]

/-- Additivity in the last slot applied to a commutator. -/
theorem associator_commutator_right (a b c d : A) :
    associator a b (c * d - d * c) = associator a b (c * d) - associator a b (d * c) :=
  associator_sub_right a b _ _

end Additive

section Star

variable {A : Type*} [NonAssocRing A] [StarRing A]

/-- Conjugation reverses the associator and negates it. -/
theorem star_associator (a b c : A) :
    star (associator a b c) = -associator (star c) (star b) (star a) := by
  simp only [associator, star_sub, star_mul]; abel

end Star

namespace Tower

universe u

variable {R : Type u} [CommRing R] [StarRing R] [TrivialStar R] {k : ℕ}

theorem associator_smul_left (r : R) (a b c : Tower R k) :
    associator (r • a) b c = r • associator a b c := by
  simp only [associator, smul_mul_assoc', smul_sub]

theorem associator_smul_mid (r : R) (a b c : Tower R k) :
    associator a (r • b) c = r • associator a b c := by
  simp only [associator, smul_mul_assoc', mul_smul_comm', smul_sub]

theorem associator_smul_right (r : R) (a b c : Tower R k) :
    associator a b (r • c) = r • associator a b c := by
  simp only [associator, mul_smul_comm', smul_sub]

/-- The symmetrized associator `A(x, y, z) + A(z, y, x)` vanishes when `2` is left regular: the
linearized flexible law. -/
theorem associator_add_associator_rev (h2 : IsLeftRegular (2 : R)) (x y z : Tower R k) :
    associator x y z + associator z y x = 0 := by
  have h := flexSum_eq_zero h2 x y z
  unfold flexSum at h
  calc associator x y z + associator z y x
      = -(x * (y * z) - x * y * z + z * (y * x) - z * y * x) := by simp only [associator]; abel
    _ = 0 := by rw [h, neg_zero]

/-- At every level, with `2` left regular, conjugation fixes the associator's arguments' order:
`star A(a, b, c) = A(star a, star b, star c)`. -/
theorem associator_star (h2 : IsLeftRegular (2 : R)) (a b c : Tower R k) :
    star (associator a b c) = associator (star a) (star b) (star c) := by
  rw [star_associator]
  exact neg_eq_of_add_eq_zero_right (associator_add_associator_rev h2 _ _ _)

omit [TrivialStar R] in
/-- Conjugating all three arguments gives the negative conjugate of the reversed associator. -/
theorem associator_star_eq_neg_star_rev (a b c : Tower R k) :
    associator (star a) (star b) (star c) = -star (associator c b a) := by
  rw [star_associator, neg_neg]

omit [TrivialStar R] in
/-- The conjugate of the associator differs from the associator of the reversed conjugates by
twice that associator,
`A(star c, star b, star a) - star A(a, b, c) = 2 • A(star c, star b, star a)`.
The relative distance of the claim is therefore `2` whenever the associator is nonzero. -/
theorem associator_star_rev_sub_star (a b c : Tower R k) :
    associator (star c) (star b) (star a) - star (associator a b c) =
      (2 : R) • associator (star c) (star b) (star a) := by
  rw [star_associator, sub_neg_eq_add, two_smul]

/-- The associator of the quaternion algebra vanishes (the case of dimension `4` of the claim). -/
theorem associator_two (x y z : Tower R 2) : associator x y z = 0 :=
  sub_eq_zero.2 (mul_assoc_two x y z)

/-- A quadratic relation: `x * x = (2 * re x) • x - dot x x • 1`. -/
theorem mul_self_eq_smul_sub (x : Tower R k) :
    x * x = (2 * re k x) • x - dot k x x • (1 : Tower R k) := by
  have h := (mul_star_eq_dot k x).1
  rw [star_eq_smul_one_sub, mul_sub, mul_smul_comm', mul_one] at h
  rw [← h]; abel

/-- The associator of an element with itself in all three slots vanishes. -/
theorem associator_self_self_self (x : Tower R k) : associator x x x = 0 := by
  unfold associator
  rw [sub_eq_zero]
  conv_lhs => rw [mul_self_eq_smul_sub x]
  conv_rhs => rw [mul_self_eq_smul_sub x]
  simp only [sub_mul, mul_sub, smul_mul_assoc', mul_smul_comm', one_mul, mul_one,
    mul_self_eq_smul_sub x]

/-- Power-associativity: the associator vanishes on the subalgebra `R 1 + R x` generated by one
element. -/
theorem associator_span_one_self (x : Tower R k) (α β γ δ ε ζ : R) :
    associator (α • (1 : Tower R k) + β • x) (γ • (1 : Tower R k) + δ • x)
      (ε • (1 : Tower R k) + ζ • x) = 0 := by
  simp only [associator_add_left, associator_add_mid, associator_add_right, associator_smul_left,
    associator_smul_mid, associator_smul_right, associator_one_left, associator_one_mid,
    associator_one_right, associator_self_self_self, smul_zero, add_zero]

omit [TrivialStar R] in
/-- A level whose associator vanishes stays associative inside every higher level, through the
embedding `lift`. -/
theorem associator_lift_eq_zero {j : ℕ} (h : ∀ x y z : Tower R j, associator x y z = 0) (m : ℕ)
    (x y z : Tower R j) : associator (lift j m x) (lift j m y) (lift j m z) = 0 := by
  unfold associator
  rw [← lift_mul, ← lift_mul, ← lift_mul, ← lift_mul]
  have := h x y z
  unfold associator at this
  rw [sub_eq_zero.1 this, sub_self]

/-- The quaternionic subalgebra is associative inside every higher level: the associator of three
lifts of quaternions vanishes. -/
theorem associator_lift_two (m : ℕ) (x y z : Tower R 2) :
    associator (lift 2 m x) (lift 2 m y) (lift 2 m z) = 0 :=
  associator_lift_eq_zero associator_two m x y z

end Tower

end CayleyDickson
