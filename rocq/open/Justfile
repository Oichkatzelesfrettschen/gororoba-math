# Justfile for the Living Verification Artifact (LVA).
#
# WHY:  Single entry point to build proofs and extract code.
# WHAT: Runs the Makefile targets from .v sources to the extraction check.
# HOW:  opam exec --switch=rocq-9.3 -- just all (full pipeline), or
#       ... just proofs (compile only).

set shell := ["sh", "-eu", "-c"]

# Default: build everything
default: all

# Build all proofs (.v -> .vo)
proofs:
    make -C . all

# Check for admitted proofs
check: proofs
    make -C . check

# Extract OCaml from Rocq and verify golden file
extract: proofs
    make -C . extract-check

# Count proof files and lines
count:
    make -C . count

# Clean all build artifacts
clean:
    make -C . clean

# Full pipeline: proofs -> check -> extract
all: check extract
